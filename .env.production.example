# Copy to .env.production and fill every required value that is currently blank.
# Never commit .env.production.
POSTGRES_DB=dermai
POSTGRES_USER=dermai_app
POSTGRES_PASSWORD=

JWT_SECRET=
SERVICE_TOKEN=
RABBITMQ_USER=dermai_events
RABBITMQ_PASSWORD=

# The public browser origin must include the scheme and must not end in a slash.
PUBLIC_ORIGIN=https://clinic.example.com
# Keep loopback when a TLS reverse proxy runs on this host. Use 0.0.0.0 only
# behind a trusted network edge that overwrites forwarded headers and blocks
# direct Internet access to this upstream port.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=3000

# Read-only AI assets on the deployment host.
AI_MODEL_DIR=./ai-service/models
AI_RAG_INDEX_DIR=./ai-service/rag-data
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Google login and email delivery. If SMTP_AUTH=true, username,
# password and sender must be configured with real deployment credentials.
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=

# Leave empty after the first administrator has been bootstrapped. An empty
# value disables the bootstrap endpoint.
BOOTSTRAP_TOKEN=
