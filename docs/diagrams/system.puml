@startuml
title DermAI Clinic - Component Diagram
skinparam componentStyle rectangle
skinparam shadowing false

actor Patient
actor Receptionist
actor Doctor
actor Admin
component "React + TypeScript\nFrontend" as Web
component "Nginx\nSPA + Reverse Proxy" as Nginx
component "Spring Cloud Gateway\nJWT / RBAC / Routing" as Gateway
component "Auth Service" as Auth
component "Patient Service" as PatientService
component "Doctor Service" as DoctorService
component "Appointment Service\nBooking Engine + WebSocket" as Appointment
component "Medical Record Service" as Record
component "Prescription Service" as Prescription
component "Notification Service\nEmail consumer" as Notification
component "FastAPI AI Service\nEfficientNet-B0 + Grad-CAM + RAG" as AI
database "PostgreSQL 16\n7 schemas / 24 business tables" as PostgreSQL
queue "RabbitMQ" as RabbitMQ
component "Redis" as Redis
artifact "best_model.pth" as Model
artifact "RAG index" as RagIndex
cloud "Gmail SMTP" as SMTP
cloud "Gemini API" as Gemini

Patient --> Web
Receptionist --> Web
Doctor --> Web
Admin --> Web
Web --> Nginx
Nginx --> Gateway : REST + WebSocket
Gateway --> Auth
Gateway --> PatientService
Gateway --> DoctorService
Gateway --> Appointment
Gateway --> Record
Gateway --> Prescription
Gateway --> AI
Gateway --> Redis
Appointment --> DoctorService : schedule / fee
PatientService --> Appointment : appointment lookup
Record --> Appointment : validate visit
Prescription --> Record : validate record
Appointment --> RabbitMQ : outbox events
RabbitMQ --> Notification
Notification --> Auth : resolve recipient
Notification --> SMTP
Auth --> PostgreSQL : auth schema
PatientService --> PostgreSQL : patient schema
DoctorService --> PostgreSQL : doctor schema
Appointment --> PostgreSQL : appointment schema
Record --> PostgreSQL : medical_record schema
Prescription --> PostgreSQL : prescription schema
Notification --> PostgreSQL : notification schema
AI --> Model
AI --> RagIndex
AI --> Gemini
@enduml
