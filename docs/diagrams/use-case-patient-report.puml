@startuml
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #42515C
skinparam ActorBorderColor #172B3B
skinparam ActorFontColor #172B3B
skinparam UsecaseBackgroundColor #172B3B
skinparam UsecaseBorderColor #172B3B
skinparam UsecaseFontColor #FFFFFF

actor "Patient" as Patient

usecase "UC01\nAuthenticate &\nManage Session" as UC01
usecase "UC01.1\nRegister With\nEmail OTP" as UC011
usecase "UC01.2\nLogin With Password\nor Google" as UC012
usecase "UC01.3\nRecover Password" as UC013
usecase "UC01.4\nRefresh or Logout\nSession" as UC014

usecase "UC02\nManage Patient\nProfile" as UC02
usecase "UC02.1\nView and Edit\nProfile" as UC021
usecase "UC02.2\nUpdate Patient\nAvatar" as UC022

usecase "UC03\nBrowse Doctors" as UC03
usecase "UC03.1\nView Doctor\nDetail" as UC031
usecase "UC03.2\nView Price and\nAvailability" as UC032

usecase "UC04\nBook Appointment" as UC04
usecase "UC04.1\nSelect Doctor\nand Date" as UC041
usecase "UC04.2\nHold or Release\nSlot" as UC042
usecase "UC04.3\nReview Booking\nInformation" as UC043
usecase "UC04.4\nValidate Booking\nPolicy" as UC044
usecase "UC04.5\nConfirm\nAppointment" as UC045

usecase "UC05\nManage Patient\nAppointments" as UC05
usecase "UC05.1\nView Upcoming\nand History" as UC051
usecase "UC05.2\nReschedule Within\nPolicy" as UC052
usecase "UC05.3\nCancel Within\nPolicy" as UC053
usecase "UC05.4\nContact Reception\nSupport" as UC054
usecase "UC05.5\nNotification\nand Review" as UC055

usecase "UC06\nAnalyze Skin\nWith AI" as UC06
usecase "UC06.1\nUpload and\nValidate Image" as UC061
usecase "UC06.2\nGenerate Top-3\nand Grad-CAM" as UC062
usecase "UC06.3\nView Assessment\nHistory" as UC063
usecase "UC06.4\nShare Assessment\nWith Doctor" as UC064

usecase "UC10\nManage Support\nConversation" as UC10
usecase "UC10.3\nReply Realtime\nand Mark Read" as UC103

Patient -left-> UC01
Patient -left-> UC02
Patient -left-> UC06
Patient -right-> UC03
Patient -right-> UC04
Patient -right-> UC05
Patient -right-> UC10

UC01 .left.> UC011 : <<include>>
UC01 .left.> UC012 : <<include>>
UC013 .right.> UC01 : <<extend>>
UC014 .right.> UC01 : <<extend>>
UC02 .left.> UC021 : <<include>>
UC022 .right.> UC02 : <<extend>>
UC03 .right.> UC031 : <<include>>
UC03 .right.> UC032 : <<include>>
UC04 .right.> UC041 : <<include>>
UC04 .right.> UC042 : <<include>>
UC04 .right.> UC043 : <<include>>
UC04 .right.> UC044 : <<include>>
UC04 .right.> UC045 : <<include>>
UC05 .right.> UC051 : <<include>>
UC052 .left.> UC05 : <<extend>>
UC053 .left.> UC05 : <<extend>>
UC054 .left.> UC05 : <<extend>>
UC055 .left.> UC05 : <<extend>>
UC06 .left.> UC061 : <<include>>
UC06 .left.> UC062 : <<include>>
UC06 .left.> UC063 : <<include>>
UC064 .right.> UC06 : <<extend>>
UC10 .right.> UC103 : <<include>>
@enduml
