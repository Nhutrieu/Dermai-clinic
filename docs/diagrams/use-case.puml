@startuml
title DermAI Clinic - Use Case Diagram
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #315A50
skinparam ActorBorderColor #172B3B
skinparam ActorFontColor #172B3B
skinparam UsecaseBackgroundColor #172B3B
skinparam UsecaseBorderColor #172B3B
skinparam UsecaseFontColor #FFFFFF
skinparam RectangleBorderColor #78978E

actor "Bệnh nhân" as Patient
actor "Lễ tân" as Receptionist
actor "Bác sĩ" as Doctor
actor "Quản trị viên" as Admin

rectangle "DermAI Clinic" {
  usecase "Đăng ký, OTP, Google Login\nvà quản lý phiên" as Auth
  usecase "Cập nhật hồ sơ cá nhân" as PatientProfile
  usecase "Xem bác sĩ, mô tả\nvà giá khám" as BrowseDoctor
  usecase "Kiểm tra da bằng AI\nTop-3 + Grad-CAM" as PatientAI
  usecase "Đặt lịch và giữ slot" as Booking
  usecase "Tự đổi/hủy\ntrong thời gian cho phép" as SelfManage
  usecase "Xem thông báo, lịch sử\nvà đánh giá phòng khám" as PatientHistory
  usecase "Chat hỗ trợ lễ tân" as Support
  usecase "Xử lý yêu cầu đặt lịch" as RequestQueue
  usecase "Đặt lịch qua hotline" as Hotline
  usecase "Đề nghị lịch cho bệnh nhân" as Proposal
  usecase "Xác nhận, đổi hoặc hủy lịch" as ReceptionManage
  usecase "Nhắc lịch, check-in\nvà ghi nhận no-show" as FrontDesk
  usecase "Nhận cuộc trò chuyện" as ClaimChat
  usecase "Quản lý hồ sơ nghề nghiệp\nvà giá công khai" as DoctorProfile
  usecase "Cấu hình lịch làm việc\nvà nghỉ phép" as DoctorSchedule
  usecase "Xem lịch và AI đính kèm" as DoctorAppointments
  usecase "Bắt đầu / hoàn tất lượt khám" as Consultation
  usecase "Ghi hồ sơ, đơn thuốc\nvà yêu cầu tái khám (tùy chọn)" as Clinical
  usecase "Quản lý bệnh nhân, bác sĩ\nvà tài khoản nhân sự" as UserAdmin
  usecase "Cấu hình giá và ngày nghỉ chung" as ClinicConfig
  usecase "Giám sát hỗ trợ và audit" as Audit
  usecase "Xem dashboard vận hành" as Dashboard
  usecase "Sửa ca khám bị quên hoàn tất" as CorrectStatus
}

Patient --> Auth
Patient --> PatientProfile
Patient --> BrowseDoctor
Patient --> PatientAI
Patient --> Booking
Patient --> SelfManage
Patient --> PatientHistory
Patient --> Support
Booking .> BrowseDoctor : <<include>>
Receptionist --> RequestQueue
Receptionist --> Hotline
Receptionist --> Proposal
Receptionist --> ReceptionManage
Receptionist --> FrontDesk
Receptionist --> ClaimChat
Doctor --> DoctorProfile
Doctor --> DoctorSchedule
Doctor --> DoctorAppointments
Doctor --> Consultation
Doctor --> Clinical
Admin --> UserAdmin
Admin --> ClinicConfig
Admin --> Audit
Admin --> Dashboard
Admin --> CorrectStatus
Admin --> ReceptionManage
@enduml
