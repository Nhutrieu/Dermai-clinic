@startuml
title DermAI Clinic - Use Case chi tiết: Quản trị viên
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #315A50
skinparam ActorBorderColor #172B3B
skinparam ActorFontColor #172B3B
skinparam UsecaseBackgroundColor #172B3B
skinparam UsecaseBorderColor #172B3B
skinparam UsecaseFontColor #FFFFFF
skinparam RectangleBorderColor #78978E

actor "Quản trị viên" as Admin
actor "Bệnh nhân" as Patient
actor "Bác sĩ" as Doctor
actor "Lễ tân" as Receptionist

rectangle "DermAI Clinic - Cổng quản trị" {
  package "Quản lý tài khoản" {
    usecase "Quản lý bệnh nhân" as Patients
    usecase "Chặn / mở chặn bệnh nhân" as BlockPatient
    usecase "Xóa dữ liệu được phép xóa" as DeletePatient
    usecase "Quản lý bác sĩ" as Doctors
    usecase "Xem hồ sơ nghề nghiệp" as DoctorProfile
    usecase "Cập nhật giá khám cơ bản" as DoctorFee
    usecase "Quản lý tài khoản nhân sự" as Staff
    usecase "Tạo tài khoản bác sĩ / lễ tân" as CreateStaff
    usecase "Khóa / mở khóa nhân sự" as BlockStaff
  }

  package "Cấu hình phòng khám" {
    usecase "Quản lý ngày nghỉ chung" as Closures
    usecase "Kiểm duyệt đánh giá" as Reviews
    usecase "Duyệt / ẩn đánh giá" as ModerateReview
  }

  package "Giám sát vận hành" {
    usecase "Xem dashboard realtime" as Dashboard
    usecase "Xem thống kê lịch và bệnh nhân" as Analytics
    usecase "Giám sát hộp thư hỗ trợ" as SupportMonitor
    usecase "Xem lịch sử thao tác nhân sự" as Audit
    usecase "Sửa trạng thái lịch bị quên" as CorrectAppointment
  }
}

Admin --> Patients
Admin --> Doctors
Admin --> Staff
Admin --> Closures
Admin --> Reviews
Admin --> Dashboard
Admin --> SupportMonitor
Admin --> Audit
Admin --> CorrectAppointment
BlockPatient .> Patients : <<extend>>
DeletePatient .> Patients : <<extend>>
DoctorProfile .> Doctors : <<include>>
DoctorFee .> Doctors : <<extend>>
CreateStaff .> Staff : <<extend>>
BlockStaff .> Staff : <<extend>>
ModerateReview .> Reviews : <<include>>
Dashboard .> Analytics : <<include>>
Patients --> Patient
Doctors --> Doctor
Staff --> Receptionist
Staff --> Doctor
@enduml
