@startuml
title DermAI Clinic - Booking Activity Diagram
skinparam shadowing false
start
:Bệnh nhân đăng nhập;
:Chọn bác sĩ;
:Chọn ngày trong 60 ngày;
:Tải lịch tuần, nghỉ phép,\nngày đóng cửa và lịch bận;
if (Có slot khả dụng?) then (Có)
  :Chọn slot;
  :Tạo HELD trong 5 phút;
  if (Xung đột ở database?) then (Có)
    :Trả 409 và tải lại slot realtime;
    stop
  else (Không)
    :Nhập lý do và xem tóm tắt;
    if (Xác nhận trước khi hold hết hạn?) then (Có)
      :Gửi Idempotency-Key;
      :HELD -> ASSIGNED/PENDING;
      :Lễ tân nhận yêu cầu realtime;
      if (Lễ tân xác nhận?) then (Có)
        :CONFIRMED;
        :Gửi thông báo / nhắc lịch;
        if (Bệnh nhân đến?) then (Có)
          :Receptionist CHECKED_IN;
          :Doctor IN_PROGRESS;
          :Doctor COMPLETED;
          :Bệnh nhân có thể đánh giá;
        else (Không, quá 30 phút)
          :Receptionist ghi NO_SHOW;
          :Gửi cảnh báo cho bệnh nhân;
        endif
      else (Đổi hoặc hủy)
        :Lễ tân ghi lý do;
        :CANCELLED hoặc tạo lịch mới;
        :Trả slot cũ cho người khác;
      endif
    else (Không)
      :HOLD_EXPIRED -> CANCELLED;
      :Tự giải phóng slot;
    endif
  endif
else (Không)
  :Thông báo hết slot / bác sĩ nghỉ;
endif
stop
@enduml
