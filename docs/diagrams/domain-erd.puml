@startuml
entity users { *id : uuid <<PK>>\n--\n*email : citext <<UQ>>\npassword_hash : text\nrole : varchar\nstatus : varchar }
entity patients { *id : uuid <<PK>>\nuser_id : uuid <<FK>>\nfull_name : varchar\ndob : date }
entity doctors { *id : uuid <<PK>>\nuser_id : uuid <<FK>>\nspecialty_id : uuid <<FK>> }
entity work_schedules { *id : uuid <<PK>>\ndoctor_id : uuid <<FK>>\nweekday : smallint\nstart_time : time\nend_time : time }
entity leave_periods { *id : uuid <<PK>>\ndoctor_id : uuid <<FK>>\nstart_at : timestamptz\nend_at : timestamptz }
entity appointments { *id : uuid <<PK>>\npatient_id : uuid <<FK>>\ndoctor_id : uuid <<FK>>\nstart_at : timestamptz\nend_at : timestamptz\nstatus : varchar\nparent_id : uuid <<FK>> }
entity medical_records { *id : uuid <<PK>>\nappointment_id : uuid <<FK,UQ>>\nfinal_diagnosis : text\nseverity : varchar\nclinical_notes : text }
entity prescriptions { *id : uuid <<PK>>\nrecord_id : uuid <<FK>>\ndoctor_id : uuid <<FK>>\nsigned_at : timestamptz }
entity prescription_items { *id : uuid <<PK>>\nprescription_id : uuid <<FK>>\ndrug_name : varchar\ndosage : varchar\ninstructions : text }
users ||--o| patients
users ||--o| doctors
doctors ||--o{ work_schedules
doctors ||--o{ leave_periods
patients ||--o{ appointments
doctors ||--o{ appointments
appointments ||--o| medical_records
medical_records ||--o{ prescriptions
prescriptions ||--|{ prescription_items
appointments |o--o{ appointments : follow-up
@enduml

