@startuml
title DermAI Clinic - Use Case chi tiết: Lễ tân
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #315A50
skinparam ActorBorderColor #172B3B
skinparam ActorFontColor #172B3B
skinparam UsecaseBackgroundColor #172B3B
skinparam UsecaseBorderColor #172B3B
skinparam UsecaseFontColor #FFFFFF
skinparam RectangleBorderColor #78978E

actor "Lễ tân" as Receptionist
actor "Bệnh nhân" as Patient
actor "Bác sĩ" as Doctor
actor "Dịch vụ thông báo" as Notification

rectangle "DermAI Clinic - Cổng lễ tân" {
  package "Yêu cầu đặt lịch" {
    usecase "Xem yêu cầu mới realtime" as Requests
    usecase "Kiểm tra bệnh nhân,\nbác sĩ và slot" as ValidateRequest
    usecase "Xác nhận lịch" as Confirm
    usecase "Đề nghị lịch khác" as Propose
    usecase "Từ chối / hủy yêu cầu" as Reject
    usecase "Nhận biết lịch đã được\nlễ tân khác xử lý" as RaceHandled
  }

  package "Đặt lịch qua hotline" {
    usecase "Tra cứu bệnh nhân" as FindPatient
    usecase "Tạo hồ sơ hotline" as CreateHotlineProfile
    usecase "Ghi số điện thoại bắt buộc" as RequirePhone
    usecase "Chọn bác sĩ, ngày và slot" as HotlineSlot
    usecase "Đọc lại và xác nhận lịch" as ReadBack
    usecase "Gửi bệnh nhân xác nhận" as SendProposal
  }

  package "Điều phối lịch và hàng đợi" {
    usecase "Xem lịch đã nhận" as AcceptedAppointments
    usecase "Đổi lịch theo yêu cầu" as Reschedule
    usecase "Hủy lịch theo yêu cầu" as Cancel
    usecase "Gửi nhắc lịch" as Reminder
    usecase "Check-in bệnh nhân" as CheckIn
    usecase "Quản lý hàng đợi" as Queue
    usecase "Ghi nhận no-show" as NoShow
    usecase "Hoàn tất ca bị quên cập nhật" as CorrectStatus
  }

  package "Hộp thư hỗ trợ" {
    usecase "Xem hội thoại chưa đọc" as Inbox
    usecase "Nhận cuộc trò chuyện" as ClaimChat
    usecase "Trả lời bệnh nhân realtime" as Reply
    usecase "Đánh dấu đã xem" as MarkRead
  }
}

Receptionist --> Requests
Receptionist --> FindPatient
Receptionist --> AcceptedAppointments
Receptionist --> Inbox
Requests .> ValidateRequest : <<include>>
Confirm .> Requests : <<extend>>
Confirm .> ValidateRequest : <<include>>
Propose .> Requests : <<extend>>
Reject .> Requests : <<extend>>
RaceHandled .> Confirm : <<extend>>
CreateHotlineProfile .> FindPatient : <<extend>>
CreateHotlineProfile .> RequirePhone : <<include>>
HotlineSlot .> FindPatient : <<include>>
HotlineSlot .> ValidateRequest : <<include>>
ReadBack .> HotlineSlot : <<include>>
SendProposal .> ReadBack : <<include>>
Reschedule .> AcceptedAppointments : <<extend>>
Cancel .> AcceptedAppointments : <<extend>>
Reminder .> AcceptedAppointments : <<extend>>
CheckIn .> AcceptedAppointments : <<extend>>
Queue .> CheckIn : <<include>>
NoShow .> AcceptedAppointments : <<extend>>
CorrectStatus .> AcceptedAppointments : <<extend>>
ClaimChat .> Inbox : <<include>>
Reply .> ClaimChat : <<include>>
Reply .> MarkRead : <<include>>
Patient --> SendProposal
Patient --> Reply
Doctor --> Queue
Notification --> Reminder
@enduml
