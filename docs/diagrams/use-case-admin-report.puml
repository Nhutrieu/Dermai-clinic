@startuml
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #42515C
skinparam ActorBorderColor #172B3B
skinparam ActorFontColor #172B3B
skinparam UsecaseBackgroundColor #172B3B
skinparam UsecaseBorderColor #172B3B
skinparam UsecaseFontColor #FFFFFF

actor "Administrator" as Admin

usecase "UC13\nAdminister Accounts\nand Clinic" as UC13
usecase "UC13.1\nManage Patients" as UC131
usecase "UC13.2\nManage Doctors\nand Fees" as UC132
usecase "UC13.3\nManage Staff\nAccounts" as UC133
usecase "UC13.4\nManage Clinic\nClosures" as UC134
usecase "UC13.5\nModerate Clinic\nReviews" as UC135

usecase "UC14\nMonitor Operations" as UC14
usecase "UC14.1\nView Realtime\nDashboard" as UC141
usecase "UC14.2\nMonitor Support\nand Audit" as UC142
usecase "UC14.3\nCorrect Forgotten\nAppointment Status" as UC143

Admin -left-> UC13
Admin -right-> UC14
UC13 .left.> UC131 : <<include>>
UC13 .left.> UC132 : <<include>>
UC13 .left.> UC133 : <<include>>
UC13 .left.> UC134 : <<include>>
UC13 .left.> UC135 : <<include>>
UC14 .right.> UC141 : <<include>>
UC14 .right.> UC142 : <<include>>
UC143 .left.> UC14 : <<extend>>
@enduml
