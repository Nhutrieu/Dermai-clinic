GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash
SERVICE_TOKEN=replace_with_a_long_random_internal_service_token
# Production: use a high-entropy secret. Prefix a 32-byte Base64 key with "base64:".
DATA_ENCRYPTION_KEY=replace_with_a_high_entropy_medical_image_key
AI_IMAGE_RETENTION_DAYS=180
GOOGLE_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com

# Gmail SMTP sends registration OTP and appointment notifications to real inboxes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=your_account@gmail.com
# payOS payment channel credentials from https://my.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_WEBHOOK_URL=https://your-public-domain.example/api/v1/payments/payos-webhook
PAYMENT_DEPOSIT_AMOUNT=100000
