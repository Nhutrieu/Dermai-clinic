GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash
SERVICE_TOKEN=replace_with_a_long_random_internal_service_token
GOOGLE_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com

# Gmail SMTP sends registration OTP and appointment notifications to real inboxes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=your_account@gmail.com
